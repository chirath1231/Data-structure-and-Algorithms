void insertbegin(int ele){
	struct node* ptr = (struct node*)malloc(sizeof(struct node));
	ptr->data = ele;
	
	
	if(head==NULL){
		head=ptr;
		ptr->next =head;
	}else{
		struct node* temp =head;
		
		while(temp->next!=head){
			temp=temp->next;
		}	
	temp->next=ptr;
	ptr->next=head;
	head=ptr;	
	}
	
}

void insertend(int ele){
